{
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "devCommand": "npx expo start --web",
  "cleanUrls": true,
  "framework": null,
  "rewrites": [
    {
      "source": "/customer-map.html",
      "destination": "/customer-map.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}